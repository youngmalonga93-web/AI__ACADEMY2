{
  "name": "ai-academy",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:local": "next dev -p 3001",
    "clean": "node scripts/clean.mjs",
    "clean:next": "node scripts/clean-next.mjs",
    "prebuild": "npm run clean:next",
    "build": "next build",
    "build:clean": "npm run clean:next && next build",
    "postbuild": "node scripts/verify-chunks.mjs && node scripts/verify-chunk-stability.mjs",
    "start": "next start",
    "start:local": "next start -p 3001",
    "preview:prod": "npm run build && npm run start:local",
    "deploy:prod": "vercel --prod",
    "lint": "next lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "validate:imports": "node scripts/validate-imports.mjs",
    "verify:chunks": "node scripts/verify-chunks.mjs && node scripts/verify-chunk-stability.mjs",
    "qa:site": "node scripts/qa-site.mjs",
    "precommit": "npm run format:check && npm run typecheck && npm run validate:imports",
    "ci": "npm run format:check && npm run typecheck && npm run validate:imports && npm test && npm run lint && npm run build",
    "prepare": "node scripts/install-hooks.mjs",
    "test": "vitest run",
    "seed:content": "tsx scripts/seed-content.ts"
  },
  "dependencies": {
    "@next/eslint-plugin-next": "^15.0.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^0.468.0",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^22.2.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.0",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
